import { getDeviceId } from './deviceService';

const API_BASE_URL = (
  process.env.EXPO_PUBLIC_API_BASE_URL || ''
).replace(/\/$/, '');


/* =========================================
   OFFICER LOGIN
========================================= */

export async function loginOfficer(serviceId, password) {
  const deviceId = await getDeviceId();

  console.log('LOGIN URL:', `${API_BASE_URL}/api/auth/login`);
  console.log('LOGIN DEVICE:', deviceId);

  const controller = new AbortController();

  const timeout = setTimeout(() => {
    controller.abort();
  }, 15000);

  try {
    const response = await fetch(
      `${API_BASE_URL}/api/auth/login`,
      {
        method: 'POST',

        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
          'ngrok-skip-browser-warning': 'true',
        },

        body: JSON.stringify({
          serviceId: serviceId.trim(),
          password,
          deviceId,
        }),

        signal: controller.signal,
      }
    );

    const text = await response.text();

    console.log('LOGIN STATUS:', response.status);
    console.log('LOGIN RESPONSE:', text);

    let data;

    try {
      data = JSON.parse(text);
    } catch {
      throw new Error(
        `Backend returned invalid response (${response.status})`
      );
    }

    if (!response.ok) {
      throw new Error(
        data?.message || `Login failed (${response.status})`
      );
    }

    return data;

  } catch (error) {
    if (error.name === 'AbortError') {
      throw new Error(
        'Login request timed out. Check the backend/ngrok connection.'
      );
    }

    throw error;

  } finally {
    clearTimeout(timeout);
  }
}


/* =========================================
   SESSION REFRESH
========================================= */

export async function refreshSession(refreshToken) {
  const deviceId = await getDeviceId();

  const response = await fetch(
    `${API_BASE_URL}/api/auth/refresh`,
    {
      method: 'POST',

      headers: {
        'Content-Type': 'application/json',
        Accept: 'application/json',
        'ngrok-skip-browser-warning': 'true',
      },

      body: JSON.stringify({
        refreshToken,
        deviceId,
      }),
    }
  );

  const data = await response.json();

  if (!response.ok) {
    throw new Error(
      data?.message || 'Unable to refresh session.'
    );
  }

  return data;
}


/* =========================================
   INITIAL PASSWORD CHANGE
========================================= */

export async function changeInitialPassword(
  currentPassword,
  newPassword,
  onboardingToken
) {
  const response = await fetch(
    `${API_BASE_URL}/api/auth/change-initial-password`,
    {
      method: 'POST',

      headers: {
        'Content-Type': 'application/json',
        Accept: 'application/json',
        Authorization: `Bearer ${onboardingToken}`,
        'ngrok-skip-browser-warning': 'true',
      },

      body: JSON.stringify({
        currentPassword,
        newPassword,
      }),
    }
  );

  const data = await response.json();

  if (!response.ok) {
    throw new Error(
      data?.message || 'Unable to change password.'
    );
  }

  return data;
}


/* =========================================
   RESET PASSWORD
========================================= */

export async function resetPassword(
  serviceId,
  currentPassword,
  newPassword
) {
  const response = await fetch(
    `${API_BASE_URL}/api/auth/reset-password`,
    {
      method: 'POST',

      headers: {
        'Content-Type': 'application/json',
        Accept: 'application/json',
        'ngrok-skip-browser-warning': 'true',
      },

      body: JSON.stringify({
        serviceId,
        currentPassword,
        newPassword,
      }),
    }
  );

  const data = await response.json();

  if (!response.ok) {
    throw new Error(
      data?.message || 'Unable to reset password.'
    );
  }

  return data;
}